# Public catalogue: obtain a free noncommercial key from https://www.themoviedb.org/settings/api
VITE_MOVIE_PROVIDER=tmdb
VITE_TMDB_API_KEY=

# Optional compatible account API; never use TMDB credentials as app login credentials.
VITE_API_BASE_URL=
VITE_ENABLE_AUTH=false
# Editing requires VITE_MOVIE_PROVIDER=custom and an authorized external service.
VITE_ENABLE_MOVIE_MANAGEMENT=false
